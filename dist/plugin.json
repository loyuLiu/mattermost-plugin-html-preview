{
  "id": "com.mattermost.html-preview",
  "name": "HTML Preview",
  "description": "Enables inline preview of HTML files in Mattermost messages",
  "homepage_url": "https://github.com/mattermost/mattermost-plugin-html-preview",
  "support_url": "https://github.com/mattermost/mattermost-plugin-html-preview/issues",
  "release_notes_url": "https://github.com/mattermost/mattermost-plugin-html-preview/releases",
  "icon_path": "assets/icon.svg",
  "version": "1.0.0",
  "min_server_version": "10.0.0",
  "webapp": {
    "bundle_path": "webapp/main.js"
  },
  "settings_schema": {
    "header": "HTML Preview Plugin Settings",
    "footer": "",
    "settings": [
      {
        "key": "EnableSandbox",
        "display_name": "Enable Sandbox Mode",
        "type": "bool",
        "help_text": "When enabled, HTML files will be rendered in a sandboxed iframe for security. Recommended to keep enabled.",
        "default": "true"
      },
      {
        "key": "MaxFileSize",
        "display_name": "Maximum File Size (KB)",
        "type": "number",
        "help_text": "Maximum HTML file size to preview in kilobytes. Files larger than this will not be previewed.",
        "placeholder": "1024",
        "default": "1024"
      }
    ]
  }
}
